    </qresource>
    <qresource prefix="/blankmaps">
        <file alias="blank_64x64.map">resources/blankmaps/blank_64x64.map</file>
        <file alias="blank_64x128.map">resources/blankmaps/blank_64x128.map</file>
        <file alias="blank_64x256.map">resources/blankmaps/blank_64x256.map</file>
        <file alias="blank_128x64.map">resources/blankmaps/blank_128x64.map</file>
        <file alias="blank_128x128.map">resources/blankmaps/blank_128x128.map</file>
        <file alias="blank_128x256.map">resources/blankmaps/blank_128x256.map</file>
        <file alias="blank_256x64.map">resources/blankmaps/blank_256x64.map</file>
        <file alias="blank_256x128.map">resources/blankmaps/blank_256x128.map</file>
        <file alias="blank_256x256.map">resources/blankmaps/blank_256x256.map</file>
        <file alias="blank_512x256.map">resources/blankmaps/blank_512x256.map</file>
    </qresource>
</RCC>
