<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <file alias="app.ico">resources/app.ico</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="IconLarge.ico">resources/images/IconLarge.ico</file>
        <file alias="Icon2025_48.ico">resources/images/Icon2025_48.ico</file>
        <file alias="lists.ico">resources/images/lists.ico</file>
        <file alias="banner03_620x100.png">resources/images/banner03_620x100.png</file>
        <file alias="TerrainType_0.bmp">resources/images/TerrainType_0.bmp</file>
        <file alias="TerrainType_1.bmp">resources/images/TerrainType_1.bmp</file>
        <file alias="TerrainType_2.bmp">resources/images/TerrainType_2.bmp</file>
        <file alias="blank_4x4.bmp">resources/images/blank_4x4.bmp</file>
    </qresource>
    <qresource prefix="/sounds">
        <file alias="earthwrk.wav">resources/sounds/earthwrk.wav</file>
    </qresource>
    <qresource prefix="/op2launcher">
        <file alias="op2launcher.exe">resources/op2launcher/op2launcher.exe</file>
        <file alias="Launcher.dll">resources/op2launcher/Launcher.dll</file>
    </qresource>
    <qresource prefix="/blankmaps">
        <file alias="blank_64x64.map">resources/blankmaps/blank_64x64.map</file>
        <file alias="blank_64x128.map">resources/blankmaps/blank_64x128.map</file>
        <file alias="blank_64x256.map">resources/blankmaps/blank_64x256.map</file>
        <file alias="blank_128x64.map">resources/blankmaps/blank_128x64.map</file>
        <file alias="blank_128x128.map">resources/blankmaps/blank_128x128.map</file>
        <file alias="blank_128x256.map">resources/blankmaps/blank_128x256.map</file>
        <file alias="blank_256x64.map">resources/blankmaps/blank_256x64.map</file>
        <file alias="blank_256x128.map">resources/blankmaps/blank_256x128.map</file>
        <file alias="blank_256x256.map">resources/blankmaps/blank_256x256.map</file>
        <file alias="blank_512x256.map">resources/blankmaps/blank_512x256.map</file>
    </qresource>
</RCC>
